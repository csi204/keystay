{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystay-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8787,
    "inspector_port": 9228
  },
  "services": [
    {
      "binding": "AUTH_USER_SERVICE",
      "service": "keystay-auth-user"
    },
    {
      "binding": "ROOM_INVENTORY_SERVICE",
      "service": "keystay-room-inventory"
    },
    {
      "binding": "RESERVATION_SERVICE",
      "service": "keystay-reservation"
    },
    {
      "binding": "HOUSEKEEPING_SERVICE",
      "service": "keystay-housekeeping"
    },
    {
      "binding": "BILLING_SERVICE",
      "service": "keystay-billing"
    },
    {
      "binding": "REPORT_ANALYTICS_SERVICE",
      "service": "keystay-report-analytics"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "KEYSTAY_ASSETS",
      "bucket_name": "keystay"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
