{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystay-reservation",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8790,
    "inspector_port": 9232
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_reservation",
      "database_id": "9a44e64f-bf82-479b-b9f9-7d9eaa5aafdb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KEYSTAY_ASSETS",
      "bucket_name": "keystay"
    }
  ],
  "triggers": {
    "crons": ["0 19 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
