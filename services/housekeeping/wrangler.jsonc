{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystay-housekeeping",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8791
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_housekeeping",
      "database_id": "7021ef1a-990a-4ea7-83fc-268cdedf95e4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KEYSTAY_ASSETS",
      "bucket_name": "keystay"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
