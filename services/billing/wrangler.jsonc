{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystay-billing",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8792
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_billing",
      "database_id": "307200ee-6cfd-4910-b0d2-84323f06a54d"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
