{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystay-report-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8793
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_report",
      "database_id": "68e60103-7895-4628-9b9f-6fc615dd0cf0"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
