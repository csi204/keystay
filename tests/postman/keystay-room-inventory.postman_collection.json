            "description": "ลบประเภทห้องพัก (มีระบบป้องกันหากมีห้องพักเชื่อมโยงอยู่)"
          }
        }
      ]
    },
    {
      "name": "3. Rooms & Availability",
      "item": [
        {
          "name": "API #13: GET /rooms (All & Filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms?status=available",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"],
              "query": [
                {
                  "key": "status",
                  "value": "available",
                  "description": "available | reserved | occupied | checked_out | cleaning | maintenance | out_of_order"
                },
                {
                  "key": "floor_id",
                  "value": "fl-1",
                  "disabled": true
                },
                {
                  "key": "room_type_id",
                  "value": "rt-std",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "ดึงรายการห้องพักทั้งหมด รองรับ Query Filters"
          }
        },
        {
          "name": "API #24: GET /rooms/available",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/available?room_type_id=rt-std",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "available"],
              "query": [
                {
                  "key": "room_type_id",
                  "value": "rt-std"
                },
                {
                  "key": "floor_id",
                  "value": "fl-1",
                  "disabled": true
                }
              ]
            },
