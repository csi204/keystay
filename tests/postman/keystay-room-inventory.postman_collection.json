            "description": "เพิ่มประเภทห้องพักใหม่ (รับค่าตัวเลขเป็น string ตามกฎ DTO)"
          }
        },
        {
          "name": "API #22: PUT /room-types/:id (Update)",
          "request": {
            "method": "PUT",
            "header": [
