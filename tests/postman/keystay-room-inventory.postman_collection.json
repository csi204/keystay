{
  "info": {
    "_postman_id": "b6a8f192-3c82-4df9-87a2-keystay-room-inventory",
    "name": "KEYSTAY — Room Inventory Service (18 APIs)",
    "description": "Collection of all 18 APIs for Room Inventory Service (Issue #2 & Issue #8)\nHost: http://localhost:8789",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8789",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "rm-101",
      "type": "string"
    },
    {
      "key": "roomTypeId",
      "value": "rt-std",
      "type": "string"
    },
    {
      "key": "floorId",
      "value": "fl-1",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response status code is valid (200, 201, 404, 409)', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 404, 409]);",
          "});",
          "pm.test('Response body is valid JSON', function () {",
          "    pm.response.to.be.json;",
          "});",
          "pm.test('Response contains success property', function () {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});",
          "pm.test('Response time is under 500ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Floors",
      "item": [
        {
          "name": "API #25: GET /floors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/floors",
              "host": ["{{baseUrl}}"],
              "path": ["floors"]
            },
            "description": "ดึงรายชื่อชั้นทั้งหมดในโรงแรม"
          }
        },
        {
          "name": "API #26: GET /floors/:id/rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/floors/{{floorId}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["floors", "{{floorId}}", "rooms"]
            },
            "description": "ดึงรายการห้องพักประจำชั้นที่ระบุ"
          }
        }
      ]
    },
    {
      "name": "2. Room Types",
      "item": [
        {
          "name": "API #20: GET /room-types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/room-types",
              "host": ["{{baseUrl}}"],
              "path": ["room-types"]
            },
            "description": "รายการประเภทห้องพักทั้งหมด (Standard, Deluxe, Suite, Presidential)"
          }
        },
        {
          "name": "API #21: POST /room-types (Create)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Family Ocean Pool Villa\",\n  \"description\": \"2-bedroom villa with private infinity pool and sea view\",\n  \"basePrice\": \"8500\",\n  \"maxOccupancy\": \"5\",\n  \"bedType\": \"1 King + 2 Singles\",\n  \"sizeSqm\": \"95\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/room-types",
              "host": ["{{baseUrl}}"],
              "path": ["room-types"]
